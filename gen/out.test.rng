<?xml version="1.0" encoding="UTF-8"?>
<grammar ns="http://www.gtk.org/introspection/core/1.0" xmlns:core="http://www.gtk.org/introspection/core/1.0" xmlns:a="http://relaxng.org/ns/compatibility/annotations/1.0" xmlns:c="http://www.gtk.org/introspection/c/1.0" xmlns:doc="http://www.gtk.org/introspection/doc/1.0" xmlns:glib="http://www.gtk.org/introspection/glib/1.0" xmlns="http://relaxng.org/ns/structure/1.0" datatypeLibrary="http://www.w3.org/2001/XMLSchema-datatypes">
  <start>
    <ref name="Repository"/>
  </start>
  <define name="Repository">
    <!-- Root node of a GIR repository. It contains  namespaces, which can in turn be implemented in several libraries -->
    <element name="repository">
      <optional>
        <attribute name="version">
          <a:documentation>version number of the repository</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:identifier-prefixes">
          <a:documentation>prefixes to filter out from C identifiers for data structures and types. For example, GtkWindow will be Window. If c:symbol-prefixes is not used, then this element is used for both</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:symbol-prefixes">
          <a:documentation>prefixes to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <!-- Other elements a repository can contain -->
      <interleave>
        <zeroOrMore>
          <ref name="Include"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="CInclude"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Package"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Namespace"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="DocFormat"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Namespace">
    <!-- Namespace which maps metadata entries to C functionality. This a similar concept to namespace in C++, but for GObject-based C libraries -->
    <element name="namespace">
      <optional>
        <attribute name="name">
          <a:documentation>name of the namespace. For example, 'Gtk'</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="version">
          <a:documentation>version number of the namespace</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:identifier-prefixes">
          <a:documentation>prefixes to filter out from C identifiers for data structures and types. For example, GtkWindow will be Window. If c:symbol-prefixes is not used, then this element is used for both</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:symbol-prefixes">
          <a:documentation>prefixes to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:prefix">
          <a:documentation>Deprecated: the same as c:identifier-prefixes. Only used for backward compatibility </a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="shared-library">
          <a:documentation>Path to the shared library implementing the namespace. It can be a comma-separated list, with relative path only</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <!-- Other elements a namespace can contain -->
      <interleave>
        <zeroOrMore>
          <ref name="Alias"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Class"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Interface"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Record"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Enum"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionMacro"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Union"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="BitField"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Callback"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constant"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Annotation"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Boxed"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="DocSection"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Annotation">
    <!-- element defining an annotation from the source code, usually a user-defined annotation associated to a parameter or a return value -->
    <element name="attribute">
      <attribute name="name">
        <a:documentation>name of the attribute</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="value">
        <a:documentation>value of the attribute</a:documentation>
        <data type="string"/>
      </attribute>
    </element>
  </define>
  <define name="CInclude">
    <!-- Dependant C header file which should be included in C programs -->
    <element name="c:include">
      <attribute name="name">
        <a:documentation>File name of the C header file. The path can be relative.</a:documentation>
        <data type="string"/>
      </attribute>
      <empty/>
    </element>
  </define>
  <define name="DocFormat">
    <element name="doc:format">
      <a:documentation>Format used for the included documentation.</a:documentation>
      <attribute name="name">
        <a:documentation>Name of the documentation format. Valid values are: gi-docgen, gtk-doc-docbook, gtk-doc-markdown, hotdoc, unknown.</a:documentation>
        <data type="string"/>
      </attribute>
      <empty/>
    </element>
  </define>
  <define name="Include">
    <!-- Dependant namespace to include with the current namespace. For example, Gtk will need the namespace GLib -->
    <element name="include">
      <attribute name="name">
        <a:documentation>name of the dependant namespace to include</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="version">
          <a:documentation>version of the dependant namespace to use</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <empty/>
    </element>
  </define>
  <define name="Package">
    <!-- The pkg-config file provided by the library -->
    <element name="package">
      <attribute name="name">
        <a:documentation>name of the pkg-config file, minus the extension</a:documentation>
        <data type="string"/>
      </attribute>
      <empty/>
    </element>
  </define>
  <define name="Alias">
    <!-- Type's name substitution, representing a typedef in C -->
    <element name="alias">
      <!-- Attributes of an Alias (see definition below) -->
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>the new name or typedef'd name</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="c:type">
        <a:documentation>the corresponding C type's name</a:documentation>
        <data type="string"/>
      </attribute>
      <!-- Other elements an alias can contain -->
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="AnyType"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Interface">
    <!-- Abstract interface to other classes -->
    <element name="interface">
      <!-- Attributes of an Interface (see definition below) -->
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the interface</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="glib:type-name">
        <a:documentation>Type name compatible with the GObject type system</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="glib:get-type">
        <a:documentation>Function to get the GObject compatible type of the interface </a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="c:symbol-prefix">
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:type">
          <a:documentation>Corresponding C type</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:type-struct">
          <a:documentation>GObject compatible C structure defining the Interface</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <!-- Other elements an interface can contain -->
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Prerequisite"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Implements"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <optional>
          <ref name="Constructor"/>
        </optional>
        <zeroOrMore>
          <ref name="Method"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="MethodInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="VirtualMethod"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Field"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Property"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Signal"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Callback"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constant"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Class">
    <!-- GObject inherited class definition -->
    <element name="class">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>Name of the class</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="glib:type-name">
        <a:documentation>GObject compatible type name of the class</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="glib:get-type">
        <a:documentation>Function to get the GObject compatible type of the class</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="parent">
          <a:documentation>Name of the parent class if any</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:type-struct">
          <a:documentation>GObject compatible C structure defining the class</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:ref-func">
          <a:documentation>GObject compatible function to reference or increase the reference count of the class</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:unref-func">
          <a:documentation>GObject compatible function to unreference or decrease the reference count of the class</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:set-value-func">
          <a:documentation>GObject compatible function to set a value of a property of the class</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:get-value-func">
          <a:documentation>GObject compatible function to get a value of a property of the class</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:type">
          <a:documentation>C type of the class</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:symbol-prefix">
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="abstract">
          <a:documentation>Binary attribute to declare the class abstract or not</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:fundamental">
          <a:documentation>Binary attribute to declare the class fundamental or not (top-level class which do not derives from any other type)</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="final">
          <a:documentation>Binary attribute to declare the class final or not (non-derivable class in a derivable hierarchy)</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <!-- Other elements a class can contain -->
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Implements"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constructor"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Method"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="MethodInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="VirtualMethod"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Field"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Property"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Signal"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Union"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constant"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Record"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Callback"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Boxed">
    <!-- Boxed type (wrapper to opaque C structures registered by the type system) -->
    <element name="glib:boxed">
      <ref name="Info.attrs"/>
      <attribute name="glib:name">
        <a:documentation>GObject compatible type name of the boxed type</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="c:symbol-prefix">
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:type-name">
          <a:documentation>GObject compatible type name of the boxed type</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:get-type">
          <a:documentation>Function to get the GObject compatible type of the boxed type</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <!-- Other elements a Boxed type can contain -->
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Record">
    <!-- Record definition, equivalent to a C struct, that is a simple structure, not a class -->
    <element name="record">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the record</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="c:type">
          <a:documentation>Corresponding C type of the record</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="disguised">
          <a:documentation>Deprecated. Binary attribute to tell if the record is disguised, i.e. whether the c:type
is a typedef that doesn't look like a pointer, but is one internally. Its second meaning
is "private" and is set when any typedef struct is parsed which doesn't also include a
full struct with fields (https://gitlab.gnome.org/GNOME/gobject-introspection/issues/101)
Replaced by "opaque" and "pointer".</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="opaque">
          <a:documentation>Binary attribute for a typedef struct that does not have a corresponding public structure definition</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="pointer">
          <a:documentation>Binary attribute for a typedef struct pointer, e.g. typedef struct Foo* FooPtr</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:type-name">
          <a:documentation>GObject compatible C type of the record</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:get-type">
          <a:documentation>Function to get the GObject compatible type of the record</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:symbol-prefix">
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="foreign">
          <a:documentation>Binary attribute to tell if the record is foreign, that is it is not available in a g-i supported library</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:is-gtype-struct-for">
          <a:documentation>Name of the GObject compatible gtype this record represents. If empty, this record will be hidden from generated public APIs.</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="copy-function">
          <a:documentation>Name of the function used to copy the record</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="free-function">
          <a:documentation>Name of the function used to free the record</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <!--
        Other elements a record can contain
        mandatory 
      -->
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Field"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Union"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Method"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="MethodInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constructor"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <!-- Some base information for most elements like version, deprecation, stability, if they are introspectable or not, etc... -->
  <define name="Info.attrs">
    <optional>
      <attribute name="introspectable">
        <a:documentation>Binary attribute which is "0" (false) if the element is not introspectable. It doesn't exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
        <choice>
          <value>0</value>
          <value>1</value>
        </choice>
      </attribute>
    </optional>
    <optional>
      <attribute name="deprecated">
        <a:documentation>Binary attribute which is "1" (true) if the element has been deprecated</a:documentation>
        <choice>
          <value>0</value>
          <value>1</value>
        </choice>
      </attribute>
    </optional>
    <optional>
      <attribute name="deprecated-version">
        <a:documentation>Version number from which this element is deprecated</a:documentation>
        <data type="string"/>
      </attribute>
    </optional>
    <optional>
      <attribute name="version">
        <a:documentation>version number of an element</a:documentation>
        <data type="string"/>
      </attribute>
    </optional>
    <optional>
      <attribute name="stability">
        <a:documentation>give the statibility status of the element. Can take the values "Stable", "Unstable" or "Private"</a:documentation>
        <data type="string"/>
      </attribute>
    </optional>
  </define>
  <!-- Documentation of elements -->
  <define name="DocElements">
    <interleave>
      <optional>
        <element name="doc-version">
          <a:documentation>Version of the documentation</a:documentation>
          <optional>
            <attribute name="xml:space">
              <a:documentation>Preserve the original formatting of the documentation from the source code</a:documentation>
              <value>preserve</value>
            </attribute>
          </optional>
          <optional>
            <attribute name="xml:whitespace">
              <a:documentation>Preserve the original formatting of the documentation from the source code. Recommended to use this instead of xml:space</a:documentation>
              <value>preserve</value>
            </attribute>
          </optional>
          <text>
            <a:documentation>the text of the version of the documentation</a:documentation>
          </text>
        </element>
      </optional>
      <optional>
        <element name="doc-stability">
          <a:documentation>give the stability of the documentation</a:documentation>
          <optional>
            <attribute name="xml:space">
              <a:documentation>Preserve the original formatting of the documentation from the source code</a:documentation>
              <value>preserve</value>
            </attribute>
          </optional>
          <optional>
            <attribute name="xml:whitespace">
              <a:documentation>Preserve the original formatting of the documentation from the source code. Recommended to use this instead of xml:space</a:documentation>
              <value>preserve</value>
            </attribute>
          </optional>
          <text>
            <a:documentation>a text value about the stability of the documentation. Usually a simple description like stable or unstable</a:documentation>
          </text>
        </element>
      </optional>
      <optional>
        <element name="doc">
          <a:documentation>documentation of an element</a:documentation>
          <optional>
            <attribute name="xml:space">
              <a:documentation>Preserve the original formatting of the documentation from the source code</a:documentation>
              <value>preserve</value>
            </attribute>
          </optional>
          <optional>
            <attribute name="xml:whitespace">
              <a:documentation>Keep the whitespace as they were in the source code</a:documentation>
              <value>preserve</value>
            </attribute>
          </optional>
          <attribute name="filename">
            <a:documentation>The file containing this documentation</a:documentation>
            <data type="string"/>
          </attribute>
          <attribute name="line">
            <a:documentation>The first line of the documentation in the source code</a:documentation>
            <data type="string"/>
          </attribute>
          <optional>
            <attribute name="column">
              <a:documentation>The first column of the documentation in the source code</a:documentation>
              <data type="string"/>
            </attribute>
          </optional>
          <text>
            <a:documentation>the text of the documentation</a:documentation>
          </text>
        </element>
      </optional>
      <optional>
        <element name="doc-deprecated">
          <a:documentation>Deprecated documentation of an element. Kept for historical reasons in general</a:documentation>
          <optional>
            <attribute name="xml:space">
              <a:documentation>Preserve the original formatting of the documentation from the source code</a:documentation>
              <value>preserve</value>
            </attribute>
          </optional>
          <optional>
            <attribute name="xml:whitespace">
              <a:documentation>Keep the whitespace as they were in the source code</a:documentation>
              <value>preserve</value>
            </attribute>
          </optional>
          <text>
            <a:documentation>the text of the deprecated documentation</a:documentation>
          </text>
        </element>
      </optional>
      <optional>
        <element name="source-position">
          <a:documentation>Position of the documentation in the original source code</a:documentation>
          <attribute name="filename">
            <a:documentation>File name of the source of the documentation</a:documentation>
            <data type="string"/>
          </attribute>
          <attribute name="line">
            <a:documentation>The first line of the documentation in the source code</a:documentation>
            <data type="string"/>
          </attribute>
          <optional>
            <attribute name="column">
              <a:documentation>The first column of the documentation in the source code</a:documentation>
              <data type="string"/>
            </attribute>
          </optional>
        </element>
      </optional>
    </interleave>
  </define>
  <!-- Information about elements can be a documentation of annotations -->
  <define name="Info.elements">
    <interleave>
      <ref name="DocElements"/>
      <zeroOrMore>
        <ref name="Annotation"/>
      </zeroOrMore>
    </interleave>
  </define>
  <define name="Constant">
    <!-- A constant entity, similar to const variable in C -->
    <element name="constant">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the constant</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="value">
        <a:documentation>value of the constant</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="c:type">
          <a:documentation>corresponding C type of the constant in C</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:identifier">
          <a:documentation>corresponding C identifier in the source code</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <!-- Other elements a constant can contain -->
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="AnyType"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Property">
    <!-- Property, that is a variable or members with getter and setter functions -->
    <element name="property">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the property</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="writable">
          <a:documentation>Binary attribute, true if the property is writeable, that is it has a setter function</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="readable">
          <a:documentation>Binary attribute, true if the property is readable, that is it has a getter function</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="construct">
          <a:documentation>Binary attribute, true if the property will be set upon construction</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="construct-only">
          <a:documentation>Binary attribute, true if the property can only be set upon construction</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="setter">
          <a:documentation>The setter function for this property</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="getter">
          <a:documentation>The getter function for this property</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="default-value">
          <a:documentation>The default value of the property, as a string; if missing, the default value is zero for integer types, and null for pointer types</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <!-- Define the transfer of ownership of the property element -->
        <ref name="TransferOwnership"/>
      </optional>
      <!-- Other elements a property can contain -->
      <interleave>
        <ref name="Info.elements"/>
        <ref name="AnyType"/>
      </interleave>
    </element>
  </define>
  <define name="Signal">
    <!-- A signal as defined in the GObject system (https://docs.gtk.org/gobject/concepts.html#signals) -->
    <element name="glib:signal">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the signal</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="detailed">
          <a:documentation>Binary attribute, true if the signal has a detailed parameter (https://docs.gtk.org/gobject/concepts.html#the-detail-argument and https://docs.gtk.org/gobject/flags.SignalFlags.html)</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="when">
          <a:documentation>When to run the signal during the 5 steps of signal emission (https://docs.gtk.org/gobject/concepts.html#signal-emission and https://docs.gtk.org/gobject/flags.SignalFlags.html)</a:documentation>
          <choice>
            <value>first</value>
            <value>last</value>
            <value>cleanup</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="action">
          <a:documentation>Binary attribute, true if the signal can be freely emitted on alive objects from user code (https://docs.gtk.org/gobject/flags.SignalFlags.html)</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="no-hooks">
          <a:documentation>Binary attribute, true if no emission hooks are supported for this signal (https://docs.gtk.org/gobject/flags.SignalFlags.html) </a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="no-recurse">
          <a:documentation>Binary attribute, true if signals emitted for an object while currently being in emission for this very object will not be emitted recursively, but instead cause the first emission to be restarted (https://docs.gtk.org/gobject/flags.SignalFlags.html)</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="emitter">
          <a:documentation>The emitter method for the signal</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <!-- Other elements a signal can contain -->
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Field">
    <!-- A field of struct of union structure, that is a C bit field, that is a fixed length in bits variable -->
    <element name="field">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the field</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="writable">
          <a:documentation>Binary attribute, true if the field is writeable</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="readable">
          <a:documentation>Binary attribute, true if the field is readable</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="private">
          <a:documentation>Binary attribute, true if the field is private to the structure or has public ("0") visibility</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="bits">
          <a:documentation>number of bits of the field</a:documentation>
          <data type="integer"/>
        </attribute>
      </optional>
      <!-- Other elements a field can contain -->
      <interleave>
        <ref name="Info.elements"/>
        <choice>
          <ref name="Callback"/>
          <ref name="AnyType"/>
        </choice>
      </interleave>
    </element>
  </define>
  <define name="Callback">
    <!-- A callback closure, that is a function called when a signal is emitted (as an answer to that signal) -->
    <element name="callback">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the callback</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="c:type">
          <a:documentation>the C type returned by the callback closure (i.e. function)</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="throws">
          <a:documentation>Binary attribute, true if the callback can throw an error</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <!-- Other elements a callback can contain -->
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Implements">
    <!-- Give the name of the interface it implements. This element is generally used within a class element -->
    <element name="implements">
      <attribute name="name">
        <a:documentation>name of the interface implemented by a class</a:documentation>
        <data type="string"/>
      </attribute>
    </element>
  </define>
  <define name="Prerequisite">
    <!-- Interface which is pre-required to implement another interface. This node is generally using within an interface element -->
    <element name="prerequisite">
      <attribute name="name">
        <a:documentation>name of the required interface</a:documentation>
        <data type="string"/>
      </attribute>
    </element>
  </define>
  <!-- A generic grammar element to represent either a simple Type or an Array of the same Type -->
  <define name="AnyType">
    <choice>
      <ref name="Type"/>
      <ref name="ArrayType"/>
    </choice>
  </define>
  <define name="Type">
    <!-- A simple type of data (as opposed to an array) -->
    <element name="type">
      <optional>
        <attribute name="name">
          <a:documentation>name of the type</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:type">
          <a:documentation>the C representation of the type</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="introspectable">
          <a:documentation>Binary attribute which is "0" (false) if the element is not introspectable. It doesn't exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <interleave>
        <ref name="DocElements"/>
        <zeroOrMore>
          <ref name="AnyType"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="ArrayType">
    <!-- An array type of data where each element is of the same type -->
    <element name="array">
      <optional>
        <attribute name="name">
          <a:documentation>name of the array type</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="zero-terminated">
          <a:documentation>Binary attribute, true if the last element of the array is zero. For example, in an array of pointers, the last pointer would be NULL</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="fixed-size">
          <a:documentation>size of an array of predetermined fixed size. For example a C array declared as char arr[5].</a:documentation>
          <data type="integer"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="introspectable">
          <a:documentation>Binary attribute which is "0" (false) if the element is not introspectable. It doesn't exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="length">
          <a:documentation>0-based index of parameter element that specifies the length of the array</a:documentation>
          <data type="integer"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:type">
          <a:documentation>the C representation of the array type</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <!-- Type of the values contained in the array -->
      <ref name="AnyType"/>
    </element>
  </define>
  <define name="TransferOwnership">
    <!-- attributes used by many elements for the transfer of ownership, with for example, a returned value. "none" if the recipient does not own the value, "container" if the recipient owns the container but not the value (for arrays or lists for example) , "full" the recipient owns the entire value. For details, see https://gi.readthedocs.io/en/latest/annotations/giannotations.html#memory-and-lifecycle-management -->
    <attribute name="transfer-ownership">
      <choice>
        <value>none</value>
        <value>container</value>
        <value>full</value>
      </choice>
    </attribute>
  </define>
  <define name="Constructor">
    <!-- A constructor of a class -->
    <element name="constructor">
      <ref name="Callable.attrs"/>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <!-- Attributes of a Callable (functions, callbacks, closures, etc...) -->
  <define name="Callable.attrs">
    <ref name="Info.attrs"/>
    <attribute name="name">
      <a:documentation>name of the Callable</a:documentation>
      <data type="string"/>
    </attribute>
    <optional>
      <!-- C identifier in the source code of the Callable -->
      <attribute name="c:identifier">
        <data type="string"/>
      </attribute>
    </optional>
    <optional>
      <attribute name="shadowed-by">
        <a:documentation>Callable it is shadowed by. For example, in C++, only one version of an overloaded callable will appear</a:documentation>
        <data type="string"/>
      </attribute>
    </optional>
    <optional>
      <attribute name="shadows">
        <a:documentation>Callable it shadows. For example, in C++, only one version of an overloaded callable will appear</a:documentation>
        <data type="string"/>
      </attribute>
    </optional>
    <optional>
      <attribute name="throws">
        <a:documentation>Binary attribute, true if the callable can throw an error</a:documentation>
        <choice>
          <value>0</value>
          <value>1</value>
        </choice>
      </attribute>
    </optional>
    <optional>
      <attribute name="moved-to">
        <a:documentation>if for backward compatibility reason the callable has a name in the source code but should be known by another one, this attribute contains the new name</a:documentation>
        <data type="string"/>
      </attribute>
    </optional>
    <optional>
      <attribute name="glib:async-func">
        <a:documentation>The name of the asynchronous version of this callable</a:documentation>
        <data type="string"/>
      </attribute>
    </optional>
    <optional>
      <attribute name="glib:sync-func">
        <a:documentation>The name of the synchronous version of this callable</a:documentation>
        <data type="string"/>
      </attribute>
    </optional>
    <optional>
      <attribute name="glib:finish-func">
        <a:documentation>The name of the callable which finishes the asynchronuos operation of this function</a:documentation>
        <data type="string"/>
      </attribute>
    </optional>
  </define>
  <define name="VarArgs">
    <!-- an element usually found in a parameter element for variadic parameter in a function or callable -->
    <element name="varargs">
      <empty/>
    </element>
  </define>
  <!-- Refer to https://gi.readthedocs.io/en/latest/annotations/giannotations.html#support-for-gobject-closures -->
  <define name="Callable.params">
    <element name="parameters">
      <a:documentation>parameters element of a callable, that is in general parameters of a function or similar</a:documentation>
      <interleave>
        <zeroOrMore>
          <element name="parameter">
            <a:documentation>parameter element of a list of parameters</a:documentation>
            <optional>
              <attribute name="name">
                <a:documentation>name of the parameter</a:documentation>
                <data type="string"/>
              </attribute>
            </optional>
            <optional>
              <attribute name="nullable">
                <a:documentation>Binary attribute, true if the parameter can have a null value</a:documentation>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="allow-none">
                <a:documentation>Deprecated. Replaced by nullable and optional</a:documentation>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="introspectable">
                <a:documentation>Binary attribute which is "0" (false) if the element is not introspectable. It doesn't exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="closure">
                <a:documentation>the parameter is a user_data for callbacks. The value points to a different parameter that is the actual callback</a:documentation>
                <data type="integer"/>
              </attribute>
            </optional>
            <optional>
              <attribute name="destroy">
                <a:documentation>the parameter is a destroy_data for callbacks. The value points to a different parameter that is the actual callback</a:documentation>
                <data type="integer"/>
              </attribute>
            </optional>
            <optional>
              <attribute name="scope">
                <a:documentation>the parameter is a callback, the value indicates the lifetime of the call. For language bindings which want to know when the resources required to do the call can be freed. "notified" valid until a GDestroyNotify argument is called, "async" only valid for the duration of the first callback invocation (can only be called once), "call" only valid for the duration of the call, can be called multiple times during the call, "forever" valid until the process terminates.</a:documentation>
                <choice>
                  <value>notified</value>
                  <value>async</value>
                  <value>call</value>
                  <value>forever</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="direction">
                <a:documentation>direction of the parameter. "in" goes into the callable, "out" for output parameters from the callable (reference in C++, var in Pascal, etc...), "inout" for both (like a pre-allocated structure which will be filled-in by the callable)</a:documentation>
                <choice>
                  <value>out</value>
                  <value>in</value>
                  <value>inout</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="caller-allocates">
                <a:documentation>Binary attribute, true if the caller should allocate the parameter before calling the callable</a:documentation>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="optional">
                <a:documentation>Binary attribute, true if the parameter is optional</a:documentation>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="skip">
                <a:documentation> Binary attribute, true if the parameter can be omitted from the introspected output</a:documentation>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <ref name="TransferOwnership"/>
            </optional>
            <interleave>
              <ref name="DocElements"/>
              <optional>
                <choice>
                  <ref name="AnyType"/>
                  <ref name="VarArgs"/>
                </choice>
              </optional>
              <zeroOrMore>
                <ref name="Annotation"/>
              </zeroOrMore>
            </interleave>
          </element>
        </zeroOrMore>
        <optional>
          <element name="instance-parameter">
            <a:documentation>instance-parameter is a parameter of a C function which is an instance of an existing object. So the callable is surely a method of a class, and this parameter points to the instance of the object. In C++, this would be equivalent to the pointer this which is not passed to the method, in Python it's equivalent to self.</a:documentation>
            <attribute name="name">
              <a:documentation>name of the instance-parameter</a:documentation>
              <data type="string"/>
            </attribute>
            <optional>
              <attribute name="nullable">
                <a:documentation>Binary attribute, true if the parameter can have a null value</a:documentation>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="allow-none">
                <a:documentation>Deprecated. Replaced by nullable and optional</a:documentation>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="direction">
                <a:documentation>direction of the parameter. "in" goes into the callable, "out" for output parameters from the callable (reference in C++, var in Pascal, etc...), "inout" for both (like a pre-allocated structure which will be filled-in by the callable)</a:documentation>
                <choice>
                  <value>out</value>
                  <value>in</value>
                  <value>inout</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <attribute name="caller-allocates">
                <a:documentation>Binary attribute, true if the caller should allocate the parameter before calling the callable</a:documentation>
                <choice>
                  <value>0</value>
                  <value>1</value>
                </choice>
              </attribute>
            </optional>
            <optional>
              <ref name="TransferOwnership"/>
            </optional>
            <interleave>
              <ref name="DocElements"/>
              <ref name="Type"/>
            </interleave>
          </element>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Callable.return">
    <!-- return value of a callable -->
    <element name="return-value">
      <optional>
        <attribute name="introspectable">
          <a:documentation>Binary attribute which is "0" (false) if the element is not introspectable. It doesn't exist in the bindings, due in general to missing information in the annotations in the original C code</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="nullable">
          <a:documentation>Binary attribute, true if the parameter can have a null value</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="closure">
          <a:documentation>the parameter is a user_data for callbacks. The value points to a different parameter that is the actual callback</a:documentation>
          <data type="integer"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="scope">
          <a:documentation>the parameter is a callback, the value indicates the lifetime of the call. For language bindings which want to know when the resources required to do the call can be freed. "notified" valid until a GDestroyNotify argument is called, "async" only valid for the duration of the first callback invocation (can only be called once), "call" only valid for the duration of the call, can be called multiple times during the call, "forever" valid until the process terminates.</a:documentation>
          <choice>
            <value>notified</value>
            <value>async</value>
            <value>call</value>
            <value>forever</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="destroy">
          <a:documentation>the parameter is a destroy_data for callbacks. The value points to a different parameter that is the actual callback</a:documentation>
          <data type="integer"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="skip">
          <a:documentation> Binary attribute, true if the parameter can be omitted from the introspected output</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <attribute name="allow-none">
          <a:documentation>Deprecated. Replaced by nullable and optional</a:documentation>
          <choice>
            <value>0</value>
            <value>1</value>
          </choice>
        </attribute>
      </optional>
      <optional>
        <ref name="TransferOwnership"/>
      </optional>
      <interleave>
        <ref name="DocElements"/>
        <zeroOrMore>
          <ref name="Annotation"/>
        </zeroOrMore>
        <ref name="AnyType"/>
      </interleave>
    </element>
  </define>
  <define name="Function">
    <!-- element defining a standalone function (as usual in most programming languages) -->
    <element name="function">
      <ref name="Callable.attrs"/>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="FunctionInline">
    <element name="function-inline">
      <a:documentation>element defining an inline function</a:documentation>
      <ref name="Callable.attrs"/>
      <interleave>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
        <ref name="DocElements"/>
      </interleave>
    </element>
  </define>
  <define name="FunctionMacro">
    <!-- element defining a pre-processor macro that behaves like a function. Unlike functions, function macros do not have a return value. -->
    <element name="function-macro">
      <ref name="Callable.attrs"/>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Method">
    <!-- element defining a method from a class -->
    <element name="method">
      <ref name="Callable.attrs"/>
      <optional>
        <attribute name="glib:set-property">
          <a:documentation>The GObject property that is set by this method</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:get-property">
          <a:documentation>The GObject property that is retrieved by this method</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="MethodInline">
    <element name="method-inline">
      <a:documentation>element defining an inline method from a type</a:documentation>
      <ref name="Callable.attrs"/>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="VirtualMethod">
    <!-- element defining a virtual method from a class, concept similar to C++ -->
    <element name="virtual-method">
      <ref name="Callable.attrs"/>
      <optional>
        <attribute name="invoker">
          <a:documentation>name of the callable called when invoking this virtual method</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <optional>
          <ref name="Callable.params"/>
        </optional>
        <optional>
          <ref name="Callable.return"/>
        </optional>
      </interleave>
    </element>
  </define>
  <define name="Union">
    <!-- element defining a type of data being a union of type, similar to union in C/C++ but extended with fields and methods -->
    <element name="union">
      <ref name="Info.attrs"/>
      <optional>
        <attribute name="name">
          <a:documentation>name of the union</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:type">
          <a:documentation>C type defining the union</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="c:symbol-prefix">
          <a:documentation>prefix to filter out from C functions. For example, gtk_window_new will lose gtk_</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:type-name">
          <a:documentation>GObject compatible type name</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:get-type">
          <a:documentation>function to retrieve the GObject compatible type of the element</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="copy-function">
          <a:documentation>Name of the function used to copy the union</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="free-function">
          <a:documentation>Name of the function used to free the union</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Field"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Constructor"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Method"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="MethodInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Record"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="BitField">
    <!-- element defining a bit field (as in C) -->
    <element name="bitfield">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the bit field</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="c:type">
        <a:documentation>corresponding C type of the bit field type</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="glib:type-name">
          <a:documentation>GObject compatible type name</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:get-type">
          <a:documentation>function to retrieve the GObject compatible type of the element</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Member"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Enum">
    <!-- element defining a enumeration type similar to enum in C/C++ -->
    <element name="enumeration">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the enumeration</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="c:type">
        <a:documentation>corresponding C type of the enumeration type</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="glib:type-name">
          <a:documentation>GObject compatible type name</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:get-type">
          <a:documentation>function to retrieve the GObject compatible type of the element</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:error-domain">
          <a:documentation>Error domain of this enumeration in a stringified form</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <interleave>
        <ref name="Info.elements"/>
        <zeroOrMore>
          <ref name="Member"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="Function"/>
        </zeroOrMore>
        <zeroOrMore>
          <ref name="FunctionInline"/>
        </zeroOrMore>
      </interleave>
    </element>
  </define>
  <define name="Member">
    <!-- element defining a member of a bit field or an enumeration -->
    <element name="member">
      <ref name="Info.attrs"/>
      <attribute name="name">
        <a:documentation>name of the member</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="value">
        <a:documentation>value of the member</a:documentation>
        <data type="string"/>
      </attribute>
      <attribute name="c:identifier">
        <a:documentation>corresponding C type of the member</a:documentation>
        <data type="string"/>
      </attribute>
      <optional>
        <attribute name="glib:nick">
          <a:documentation>short nickname of the member (from GEnumValue/GFlagsValue)</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <optional>
        <attribute name="glib:name">
          <a:documentation>name of the member (from GEnumValue/GFlagsValue)</a:documentation>
          <data type="string"/>
        </attribute>
      </optional>
      <ref name="Info.elements"/>
    </element>
  </define>
  <define name="DocSection">
    <!-- element defining a gtk-doc documentation section -->
    <element name="docsection">
      <attribute name="name">
        <data type="string"/>
      </attribute>
      <ref name="DocElements"/>
    </element>
  </define>
</grammar>
